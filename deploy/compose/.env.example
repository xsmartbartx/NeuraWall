# Copy to ./.env next to docker-compose.yml and fill in.

# Public hostname (DNS must point here for automatic HTTPS). "localhost" for a local trial.
NEURAWALL_DOMAIN=localhost

# Generate with: openssl rand -base64 48
NEURAWALL_SECRET_KEY=
POSTGRES_PASSWORD=

# First admin account. The initial password is written to /data/initial-admin-password.txt
# in the control-plane volume:  docker compose exec control-plane cat /data/initial-admin-password.txt
NEURAWALL_ADMIN_EMAIL=admin@example.com

# Optional: enables Claude-powered Tier 3 triage, rule drafting and incident narration.
ANTHROPIC_API_KEY=

# Require a second person to approve every rule change (recommended for teams).
NEURAWALL_REQUIRE_FOUR_EYES=false

# Evaluation only: generate synthetic traffic from a built-in sensor.
NEURAWALL_DEMO_MODE=false

# For `docker compose --profile demo up`: an enrollment token from Console → Fleet.
NEURAWALL_DEMO_ENROLLMENT_TOKEN=
