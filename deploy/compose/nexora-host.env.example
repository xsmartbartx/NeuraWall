# /opt/neurawall/.env on the NEXORA host (chmod 600). Generate secrets with: openssl rand -base64 48
NEURAWALL_DOMAIN=neurawall.onenexora.com
NEURAWALL_SECRET_KEY=
POSTGRES_PASSWORD=
NEURAWALL_ADMIN_EMAIL=admin@neurawall.local
NEURAWALL_REQUIRE_FOUR_EYES=false
# Synthetic traffic so the console has data before real nodes are enrolled.
NEURAWALL_DEMO_MODE=true
ANTHROPIC_API_KEY=
# Needed when the key is not scoped to a workspace (Anthropic Console -> Settings -> Workspaces).
ANTHROPIC_WORKSPACE_ID=
# Stripe self-serve billing (shared NEXORA Stripe account). Leave empty to run on the licence plan below.
NEURAWALL_BILLING__PLAN=community
NEURAWALL_BILLING__STRIPE_SECRET_KEY=
NEURAWALL_BILLING__STRIPE_WEBHOOK_SECRET=
# NeuraWall's own Customer Portal configuration (the account default belongs to Vigilo).
NEURAWALL_BILLING__STRIPE_PORTAL_CONFIGURATION_ID=
NEURAWALL_BILLING__PRICE_PRO_MONTH=
NEURAWALL_BILLING__PRICE_PRO_YEAR=
NEURAWALL_BILLING__PRICE_BUSINESS_MONTH=
NEURAWALL_BILLING__PRICE_BUSINESS_YEAR=
NEURAWALL_BILLING__PRICE_ENTERPRISE_MONTH=
NEURAWALL_BILLING__PRICE_ENTERPRISE_YEAR=
# Linked mode (optional): the plan comes from your NEXORA organisation instead of the Stripe/licence settings above.
# An organisation API key with the neurawall:link scope. Leave empty to stay standalone.
NEURAWALL_NEXORA__API_KEY=
NEURAWALL_NEXORA__API_URL=
NEURAWALL_NEXORA__CONSOLE_URL=
# Let verified members of NEURAWALL_SSO_REQUIRED_ORG_ID sign in without an admin creating them first (they start as viewers).
NEURAWALL_SSO_JIT=false
# admin_only keeps password sign-in for admins (break-glass) and sends everyone else through SSO.
NEURAWALL_LOCAL_LOGIN=enabled
